{
    "version": 2,
    "builds": [
      {
        "src": "pages/**/*.js",
        "use": "@vercel/next"
      }
    ],
    "env": {
      "NEXT_PUBLIC_API_BASE_URL": "https://unifynetserver.jisonline.site",
      "NEXT_PUBLIC_API_SOCKET_URL_CHAT": "https://unifynetserver.jisonline.site:8000",
      "NEXT_PUBLIC_API_SOCKET_URL_WEBRTC": "https://unifynetserver.jisonline.site:4000",
      "NEXT_PUBLIC_API_SOCKET_URL_NOTIFICATION":"https://unifynetserver.jisonline.site:9000"
    },
    "rewrites": [
      {
        "source": "/(.*)",
        "destination": "https://unifynetserver.jisonline.site/$1"
      },
      {
        "source": "/socket.io/(.*)",
        "destination": "https://unifynetserver.jisonline.site/socket.io/$1"
      },
      {
        "source": "/webrtcSocket.io/(.*)",
        "destination": "https://unifynetserver.jisonline.site/webrtcSocket.io/$1"
      },
      {
        "source": "/webrtcSocket.io/(.*)",
        "destination": "https://unifynetserver.jisonline.site/notificationSocket.io/$1"
      }
    ]
  }
  